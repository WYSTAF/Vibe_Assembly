# Pure Rust build artifacts
target/
**/target/
Cargo.lock.backup

# Authoritative runtime lockfile (ADR-007 single-writer guard)
.ai/.task.lock

# Per-workspace trajectory DAG (runtime state, recreated on demand)
.ai/session.jsonl
.ai/session.jsonl.*

# Machine-local model combo configuration (.example is tracked)
.ai/model_combo.txt

# System & OS overheads
.DS_Store
Thumbs.db
*.log

# IDE & Editor session configurations
.claude/
.idea/
.vscode/
*.iml

# Local references and scratch.
# Upstream sources are fetched, never committed — they are large and are
# study material, not part of the product.
/references/upstream/
/references/*.zip
*.tmp
*.bak
